  ],
  "description": "Self-configuring framework for medical image segmentation that automatically adapts its architecture, preprocessing, training, and post-processing to any new dataset without manual intervention. The de-facto baseline and benchmark for 3D medical image segmentation, dominating MICCAI segmentation challenges since 2018.",
  "url": "https://github.com/MIC-DKFZ/nnUNet",
