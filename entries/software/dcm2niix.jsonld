  "identifier": "dcm2niix",
  "name": "dcm2niix",
  "description": "De facto standard tool for converting DICOM neuroimaging data to NIfTI format with BIDS-compliant JSON sidecars. Handles vendor-specific DICOM quirks across GE, Siemens, Philips, and Canon scanners, producing vendor-neutral NIfTI output with complete acquisition metadata. Embedded in 100+ downstream neuroimaging tools and pipelines including fMRIprep, FreeSurfer, SPM12, AFNI, and heudiconv. Available as a standalone CLI, as a library, and bundled in Docker-based BIDS conversion pipelines. Developed and maintained by Chris Rorden's lab (University of South Carolina).",
  "url": "https://github.com/rordenlab/dcm2niix",
  "codeRepository": "https://github.com/rordenlab/dcm2niix",
  "license": "BSD-2-Clause",
  "version": "1.0.20260416",
  "dateModified": "2026-05-07",
