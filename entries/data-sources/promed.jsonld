      "@type": "schema:WebPage",
      "url": "https://www.statnews.com/2023/08/03/promed-early-warning-system-on-disease-outbreaks-appears-near-collapse/",
      "mach:evidenceType": "academic-reference",
      "schema:name": "ProMED, an early warning system on disease outbreaks, appears near collapse. STAT News, 2023."
    }
  ],
  "schema:comment": "entry_status: watchlist — re-assess when access model stabilises. RSS permanently closed 2023; commercial API (Samdesk) covers 2025+ only. Monitor ISID financial situation and any restoration of open access."
}
