    }
  ],
  "mach:weightsLicense": "Apache-2.0",
  "mach:trainingDataSummary": "Over 1 million image-mask pairs from 30+ medical imaging modalities sourced from multiple public datasets. Covers CT, MRI, ultrasound, X-ray, endoscopy, dermoscopy, and microscopy across diverse anatomical structures.",
  "mach:intendedUse": "Universal medical image segmentation for research and clinical decision support development. Promptable via bounding boxes across modalities without per-dataset retraining. Not a cleared medical device.",
  "mach:aiActRiskClass": "high-risk-candidate",
  "mach:evaluationReference": [
    {
      "@type": "schema:ScholarlyArticle",
      "url": "https://doi.org/10.1038/s41467-024-44824-z",
      "schema:name": "Segment anything in medical images. Nature Communications, 2024."
    }
  ],
  "mach:governance": "academic",
  "mach:foundation": "Bo Wang Lab, University of Toronto",
  "mach:category": "medical-imaging-signals",
