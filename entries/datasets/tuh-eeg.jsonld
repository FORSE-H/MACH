  "identifier": "tuh-eeg",
  "name": "TUH EEG Corpus",
  "alternateName": [
    "Temple University Hospital EEG Corpus",
    "TUEG"
  ],
  "description": "The largest publicly available clinical EEG database, containing 60,000+ recordings from Temple University Hospital (2002–present) across 7 annotated sub-corpora: TUEG (general clinical EEG, 26,846 recordings), TUSZ (seizure detection with temporal start/stop channel-level annotations), TUEP (epilepsy classification, 100 with/100 without, including medication metadata), TUAB (normal vs. abnormal), TUAR (5 artifact types: eye movement, chewing, shivering, electrode, muscle), TUEV (6-class EEG event classification), and TUSL (EEG slowing events). EDF+ format, 24–36 channels at 250 Hz. Explicitly permissive for both research and commercial use. Access requires registration and SSH key (approved within 24–48 hours). Maintained by the Neural Engineering Data Consortium (NEDC) at Temple University.",
  "url": "https://isip.piconepress.com/projects/nedc/html/tuh_eeg/",
  "license": "Custom — research and commercial use permitted; registration required",
