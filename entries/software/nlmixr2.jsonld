  "identifier": "nlmixr2",
  "name": "nlmixr2",
  "description": "R package for nonlinear mixed-effects (NLME) modelling in pharmacometrics, designed to compete with commercial tools such as NONMEM and Monolix and explicitly suitable for regulatory submissions (FDA, EMA). Supports PK/PD modelling, multiple endpoints, model piping, censoring, and automated reporting. Interoperates with NONMEM and Monolix via babelmixr2, and integrates with a rich ecosystem of companion packages: xpose.nlmixr2 and ggPMX for diagnostics, shinyMixR for a Shiny-based GUI, nlmixr2lib for a model library, and nlmixr2targets for workflow pipelines. Available on CRAN with binaries for multiple platforms. GPL-3.0 licensed, community-governed with an advisory committee.",
  "url": "https://nlmixr2.org/",
  "codeRepository": "https://github.com/nlmixr2/nlmixr2",
  "license": "GPL-3.0",
  "version": "5.0.0",
  "dateModified": "2025-11-30",
