  "mach:category": "ai-ml-models",
  "mach:deploymentContext": [
    "self-hosted",
    "embedded-library"
  ],
  "mach:weightsLicense": "MIT (weights released on Hugging Face under the same licence as the code).",
  "mach:trainingDataSummary": "Over one million medical images spanning multiple modalities and anatomies; evaluated across 20 datasets.",
  "mach:intendedUse": "A research tool for compressing medical images into latents to accelerate downstream model training and inference — not a clinical diagnostic model.",
