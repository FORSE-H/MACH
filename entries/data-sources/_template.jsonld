{
  "@context": "../../data/context/mach.jsonld",
  "@id": "https://github.com/FORSE-H/MACH/tree/main/entries/data-sources/REPLACE-WITH-SLUG",
  "@type": ["schema:DataCatalog", "mach:DataSource"],

  "identifier": "REPLACE-WITH-SLUG",
  "name": "Data Source Name",
  "description": "One sentence: what this API / registry / portal provides.",
  "url": "https://REPLACE-with-the-SOURCE-OWN-page-not-a-related-project",

  "license": "SPDX-EXPRESSION-HERE",

  "keywords": ["clinical-data", "REPLACE-keywords"],

  "copyrightHolder": { "@type": "Organization", "name": "Organisation Name", "url": "https://org-site" },

  "mach:governance": "public-body",
  "mach:category": "data-sources",
  "mach:deploymentContext": ["hosted-service"],
  "mach:accessModel": "open-api",
  "mach:editorialReviewedAt": "YYYY-MM-DD",

  "_comment": "mach:subcategory is assigned by scripts/classify.py — leave it out. A data source is usually a hosted API/portal, so 'license' is the data/content licence and there may be no code repo. Remove this _comment before committing.",

  "mach:evidence": [
    { "@type": "schema:WebPage", "url": "https://REPLACE-source-page", "mach:evidenceType": "primary-instance" }
  ],

  "mach:licenseUrl": "https://REPLACE-licence-page"
}
