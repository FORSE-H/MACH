  "name": "OpenMRS",
  "alternateName": [
    "OpenMRS Platform",
    "O3",
    "OpenMRS 3"
  ],
  "description": "Open-source electronic medical records platform designed for resource-limited settings, deployed in 60+ countries across Africa, Asia, and Latin America with over 15 years of production use. Foundation-governed by OpenMRS Inc. with a large global volunteer community. Available in two active streams: OpenMRS 2.x (Java/Hibernate backend, legacy UI) and OpenMRS 3.x/O3 (modern microfrontend architecture built on React/TypeScript with a component-based ESM system). FHIR R4 support via the dedicated openmrs-module-fhir2 module; REST API via openmrs-module-webservices.rest. MPL-2.0 licensed, Docker-ready, offline-capable for low-connectivity environments.",
  "url": "https://openmrs.org",
  "codeRepository": "https://github.com/openmrs/openmrs-core",
