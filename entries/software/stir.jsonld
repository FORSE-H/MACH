  "identifier": "stir",
  "name": "STIR",
  "alternateName": [
    "Software for Tomographic Image Reconstruction"
  ],
  "description": "Leading open-source library for PET and SPECT tomographic image reconstruction. Provides iterative and analytical reconstruction algorithms, scatter correction, motion correction, and kinetic modelling support. Includes Python bindings and integrates with the SIRF reconstruction framework. Widely used in nuclear medicine physics research and scanner development. Developed at University College London with contributions from international nuclear medicine imaging groups.",
  "url": "http://stir.sourceforge.net/",
