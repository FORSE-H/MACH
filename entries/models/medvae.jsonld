  "identifier": "medvae",
  "name": "MedVAE",
  "alternateName": [
    "Efficient Automated Interpretation of Medical Images with Large-Scale Generalizable Autoencoders"
  ],
  "description": "Family of six large-scale 2D and 3D autoencoders that compress high-resolution medical images into much smaller latent representations, pretrained on over one million images across modalities and anatomies. The compact latents speed up downstream training and inference (classification, finetuning) while preserving clinically relevant detail. MIT-licensed code and weights, installable via pip and released on Hugging Face. MIDL 2025 (Oral). Stanford MIMI Lab.",
  "url": "https://huggingface.co/stanfordmimi/MedVAE",
  "codeRepository": "https://github.com/StanfordMIMI/MedVAE",
  "relatedLink": [
    "https://arxiv.org/abs/2502.14753",
    "https://pypi.org/project/medvae/"
  ],
  "license": "MIT",
  "programmingLanguage": [
    "Python"
  ],
  "keywords": [
    "imaging-model",
    "autoencoder",
    "medical-imaging",
    "latent-compression",
    "representation-learning",
    "foundation-model",
    "midl",
    "stanford"
  ],
