  "identifier": "trialgpt",
  "name": "TrialGPT",
  "description": "End-to-end LLM framework for zero-shot patient-to-clinical-trial matching. Comprises three stages: retrieval (recalls 90%+ of relevant trials using under 6% of the collection), criterion-level eligibility matching (87.3% accuracy, close to expert performance), and trial-level ranking (outperforms competing models by 28.8–53.5%). A user study demonstrated 42.6% reduction in clinical trial screening time. Published in Nature Communications (2024). Maintained by NCBI/NLM as a US Government work in the public domain.",
  "url": "https://www.ncbi.nlm.nih.gov/research/trialgpt/",
  "codeRepository": "https://github.com/ncbi-nlp/TrialGPT",
  "license": "LicenseRef-US-Government-public-domain",
  "version": "1.0.0",
  "dateModified": "2024-08-08",
