  "identifier": "medagentbench",
  "name": "MedAgentBench",
  "description": "FHIR-native benchmark for evaluating AI agents on real-world clinical tasks authored by practising physicians. Contains 300 tasks across 10 clinical specialties, 100 synthetic patient profiles, and over 700,000 FHIR data points. Tasks mirror genuine EHR workflows: ordering labs, interpreting results, writing referrals, and medication management. Published in NEJM AI 2025.",
  "url": "https://ai.nejm.org/doi/full/10.1056/AIdbp2500144",
  "codeRepository": "https://github.com/stanfordmlgroup/MedAgentBench",
