  "identifier": "healthdcat-ap",
  "name": "HealthDCAT-AP",
  "alternateName": [
    "Health Data Catalogue Application Profile"
  ],
  "description": "The official EU metadata specification for describing health datasets for secondary use, extending DCAT-AP 3.0 with health-domain semantics. Mandated by Article 77 of the EHDS Regulation (EU) 2025/327, which requires Health Data Access Bodies to publish dataset catalogues using this profile. Covers privacy properties, GDPR-aligned dataset descriptions, and cross-border discoverability across EU Member States. Includes a SHACL validator, Dataset Descriptions Assistant, and Metadata Model Explorer. Hosted on European Commission infrastructure and adopted in the HealthData@EU Central Platform and national EHDS implementations such as the Health-RI Data Catalogue.",
  "url": "https://healthdataeu.pages.code.europa.eu/healthdcat-ap/releases/release-5/",
  "codeRepository": "https://code.europa.eu/healthdataeu/healthdcat-ap",
  "license": "CC-BY-4.0",
  "version": "Release 5",
  "dateModified": "2025-09-22",
  "keywords": [
    "metadata-standard",
    "health-data",
    "ehds",
    "european-health-data-space",
    "dcat-ap",
