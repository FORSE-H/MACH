  "identifier": "mriqc",
  "name": "MRIQC",
  "alternateName": [
    "MRI Quality Control"
  ],
  "description": "Automated MRI quality control tool that extracts image quality metrics (IQMs) and generates visual reports for structural (T1w, T2w) and functional brain MRI scans. Runs before any preprocessing as a first-pass quality gate. BIDS-compliant, containerised via Docker, and integrates with Nipype workflows using ANTs and AFNI. Produces no-reference IQMs without requiring a ground-truth reference scan. NIH-funded (NIBIB, NIMH, NINDS), maintained by the NiPreps Community. Apache-2.0, 363 stars, v24.0.2. Used alongside fMRIPrep in standard neuroimaging pipelines.",
  "url": "https://mriqc.readthedocs.io/",
  "codeRepository": "https://github.com/nipreps/mriqc",
