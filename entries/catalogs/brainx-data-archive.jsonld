  "identifier": "brainx-data-archive",
  "name": "BrainX Community Data Archive",
  "alternateName": [
    "BrainX Data Archive",
    "brainxai.org/data"
  ],
  "description": "Clinician-curated discovery archive of links to open healthcare and biomedical datasets, maintained by the BrainX Community — a ~5,000-member international group for AI in healthcare co-founded by Dr. Frank Papay and Dr. Piyush Mathur. The archive does not host data itself; it organises and links out to datasets held on Hugging Face, PhysioNet, Zenodo, TCIA, and institutional repositories, spanning medical imaging (CT, MRI, X-ray, ultrasound, pathology), clinical notes and EHR data, surgical video, genomics, and wearable-sensor data across many clinical specialties. Notable surfaced items include HC4 (a 65-billion-token healthcare pretraining corpus), a Synthea-generated synthetic cohort of ~575,000 patients with complete histories, and MIMIC-IV-Ext clinical time-series collections. The archive page is publicly browsable without registration; licences and access conditions vary per linked dataset and are governed by each host repository rather than by BrainX.",
  "url": "https://brainxai.org/data/",
  "license": "LicenseRef-no-license-file",
  "mach:licenseVerified": false,
