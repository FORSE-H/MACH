  "mach:huggingFaceUrl": "https://huggingface.co/collections/wanglab/bioreason-683cd17172a037a31d208f70",
  "mach:weightsLicense": "Apache-2.0",
  "mach:trainingDataSummary": "Trained on genomic sequences paired with biological knowledge bases including KEGG pathways and variant effect datasets. Fuses DNA foundation model embeddings with LLM reasoning.",
  "mach:intendedUse": "Biological reasoning research — disease pathway prediction, variant effect classification, gene-disease association. Sits at the genomics-clinical boundary. Not a cleared medical device.",
  "mach:governance": "academic",
  "mach:foundation": "Bo Wang Lab, University of Toronto",
