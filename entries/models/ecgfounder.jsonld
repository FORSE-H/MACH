    "cardiology",
    "medical-imaging",
    "clinical-research"
  ],
  "mach:deploymentContext": [
    "embedded-library",
    "self-hosted"
  ],
  "mach:judgement": "Assess",
  "mach:judgementReason": "Strong clinical foundation model for ECG — published in NEJM AI (2025), pretrained on 10M+ recordings, MIT license, HuggingFace weights, Peking University Digital Health governance. Assess rather than Adopt due to 25 stars, no versioned releases, and limited external validation outside the paper. The NEJM AI publication is a meaningful quality signal that outweighs the low star count. Leading open foundation model for 12-lead ECG analysis.",
  "mach:editorialReviewedAt": "2026-05-24",
