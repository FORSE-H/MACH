  "mach:weightsLicense": "Apache-2.0",
  "mach:trainingDataSummary": "18 million cardiac ultrasound images for self-supervised pretraining using JEPA latent prediction objectives. Covers diverse echocardiographic views and cardiac pathologies.",
  "mach:intendedUse": "Echocardiography analysis research — LVEF estimation, cardiac structure assessment, downstream fine-tuning for cardiac prediction tasks. Not a cleared medical device.",
  "mach:aiActRiskClass": "high-risk-candidate",
