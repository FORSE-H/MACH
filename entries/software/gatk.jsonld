  "name": "GATK",
  "alternateName": [
    "Genome Analysis Toolkit",
    "GATK4"
  ],
  "description": "The industry-standard toolkit for variant discovery in high-throughput sequencing data, developed by the Broad Institute. Implements best-practice pipelines for germline and somatic variant calling, copy number variation, and structural variant detection across WGS, WES, and targeted panel data.",
