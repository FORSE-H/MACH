  "identifier": "openehr",
  "name": "openEHR",
  "alternateName": [
    "openEHR Specification",
    "openEHR Platform"
  ],
  "description": "Open specification for a vendor-neutral EHR platform based on a two-level modelling paradigm — separating stable technical architecture from clinician-defined content models (archetypes). Enables lifelong, patient-centric, semantically computable health records.",
  "url": "https://openehr.org",
  "codeRepository": "https://github.com/openEHR",
  "logo": "../../logos/openehr.svg",
