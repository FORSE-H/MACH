  "identifier": "promed",
  "name": "ProMED",
  "alternateName": [
    "Program for Monitoring Emerging Diseases",
    "ProMED-mail"
  ],
  "description": "Internet-based outbreak surveillance system launched in 1994 by the International Society for Infectious Diseases (ISID). Operated 24/7 by a global team of 30 subject-matter expert moderators across 24 countries who curate and analyse reports of infectious disease outbreaks, antimicrobial resistance events, foodborne illness, and animal disease events worldwide. Holds 31 years of outbreak archive data. Historically a gold-standard open surveillance resource used by WHO, CDC, and researchers during SARS, H1N1, Ebola, and COVID-19. Access model changed significantly in 2023: the free RSS feed was permanently closed to prevent unauthorised use. A commercial API became available in late 2024 via a partnership with Samdesk, covering alerts from January 2025 onwards only. The historical archive remains searchable on the website but is not programmatically accessible under open terms.",
  "url": "https://promedmail.org/",
  "relatedLink": [
    "https://isid.org/promed-samdesk-api/",
    "https://www.isid.org/"
  ],
  "license": "LicenseRef-proprietary",
  "dateModified": "2024-11-01",
