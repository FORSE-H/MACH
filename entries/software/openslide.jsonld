  "identifier": "openslide",
  "name": "OpenSlide",
  "description": "Low-level C library and Python bindings for reading whole-slide image (WSI) files across 11 proprietary vendor formats — including Aperio SVS, DICOM, Hamamatsu, Leica, Philips TIFF, Ventana, and Zeiss. The de-facto standard abstraction layer for WSI file I/O, used by QuPath, HistomicsTK, and most computational pathology pipelines to eliminate vendor lock-in. Provides access to image pyramids, metadata, ICC profiles, and associated thumbnail images. LGPL-2.1, C with Python bindings, 501 stars, 260 forks, v4.0.0 (October 2023). Developed at Carnegie Mellon University with NIH support.",
  "url": "https://openslide.org/",
  "codeRepository": "https://github.com/openslide/openslide",
  "license": "LGPL-2.1-only",
  "version": "4.0.0",
  "dateModified": "2023-10-11",
