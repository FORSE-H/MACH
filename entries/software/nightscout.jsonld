  "identifier": "nightscout",
  "name": "Nightscout",
  "alternateName": [
    "cgm-remote-monitor",
    "CGM in the Cloud"
  ],
  "description": "Open-source web application for real-time remote monitoring of continuous glucose monitor (CGM) data, created and maintained by the diabetes patient and caregiver community. Reads CGM readings from devices by Dexcom, Freestyle, and Medtronic via uploaders (xDrip+, Spike, xDrip4iOS), stores data in MongoDB, and displays glucose values graphically with high/low alarms and 30-minute predictive alerts. Integrates with DIY closed-loop automated insulin delivery systems including OpenAPS, Loop, and AndroidAPS. Self-hosted on any cloud platform or local server. No corporate backing — entirely volunteer-maintained. AGPL-3.0, 2.8k stars, 73k forks, v15.0.7.",
  "url": "https://nightscout.github.io/",
  "codeRepository": "https://github.com/nightscout/cgm-remote-monitor",
