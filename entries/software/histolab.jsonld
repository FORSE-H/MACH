  "identifier": "histolab",
  "name": "histolab",
  "description": "Python library for whole slide image (WSI) processing in computational pathology. Provides tissue detection, tiling, stain normalisation, and dataset preparation tools for digital pathology pipelines. Designed to standardise WSI preprocessing for deep learning workflows.",
  "url": "https://histolab.readthedocs.io/",
  "codeRepository": "https://github.com/histolab/histolab",
