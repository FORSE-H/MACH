  "identifier": "digital-slide-archive",
  "name": "Digital Slide Archive",
  "alternateName": [
    "DSA"
  ],
  "description": "Web-based platform for managing, annotating, and running computational algorithms on large whole-slide and microscopy images. Supports image ingestion from local filesystems and S3, fine-grained user access controls, collaborative annotation and review workflows, and algorithm execution via HistomicsTK and slicer_cli_web plugins. Provides a REST API for programmatic access. NIH-funded (U24-CA194362). Apache 2.0, Python, 136 stars, 61 forks. Developed and maintained by Kitware in conjunction with HistomicsTK. Live demo at demo.kitware.com.",
  "url": "https://digitalslidearchive.github.io/digital_slide_archive/",
  "codeRepository": "https://github.com/DigitalSlideArchive/digital_slide_archive",
  "license": "Apache-2.0",
