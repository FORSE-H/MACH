    {
      "@type": "Organization",
      "name": "National Library of Medicine / NIH",
      "url": "https://www.nlm.nih.gov/"
    }
  ],
  "mach:governance": "government",
  "mach:category": "data-sources",
  "mach:maturity": "production",
  "mach:deploymentContext": [
    "cloud-only"
  ],
  "mach:judgement": "Adopt",
  "mach:judgementReason": "The authoritative open registry of 500,000+ clinical trials, updated daily, public domain. API v2 (2024) provides OpenAPI-compliant structured access to trial metadata, eligibility criteria, results, and status. Bulk download available. Used in trial matching AI, systematic reviews, evidence synthesis pipelines, and regulatory intelligence. No authentication required. The single most important open data source for clinical research infrastructure.",
  "mach:editorialReviewedAt": "2026-05-14",
