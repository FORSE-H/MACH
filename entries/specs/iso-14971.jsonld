  "identifier": "iso-14971",
  "name": "ISO 14971:2019",
  "alternateName": [
    "ISO 14971",
    "Medical devices — Application of risk management to medical devices"
  ],
  "description": "The international standard for risk management of medical devices, including software as a medical device (SaMD) and AI/ML-enabled devices. Defines a systematic process for identifying hazards, estimating and evaluating risks, controlling risks, and monitoring effectiveness. Mandatory for CE marking under EU MDR (2017/745) and IVDR (2017/746), and aligned with FDA guidance on device risk management. Applies to hardware, software, and AI systems that meet the definition of a medical device. Accompanied by ISO/TR 24971:2020 (implementation guidance). Published by ISO. Paid standard — purchase required.",
  "url": "https://www.iso.org/standard/72704.html",
