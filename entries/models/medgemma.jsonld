  "identifier": "medgemma",
  "name": "MedGemma",
  "alternateName": [
    "Health AI Developer Foundations MedGemma",
    "HAI-DEF MedGemma"
  ],
  "description": "Google's family of Gemma 3 variants fine-tuned for medical text and image comprehension, released under the Health AI Developer Foundations (HAI-DEF) initiative. Available in 4B multimodal (text + medical images) and 27B multimodal/text-only variants. Supports chest X-ray report generation, medical visual QA, radiology/dermatology/pathology/ophthalmology image analysis, and EHR/FHIR record comprehension. MedGemma 4B scores 88.9 F1 on MIMIC-CXR and 64.4% on MedQA — significantly outperforming base Gemma 3 4B. 477k+ monthly HuggingFace downloads. Code Apache-2.0; model weights under Health AI Developer Foundations licence.",
  "url": "https://developers.google.com/health-ai-developer-foundations/medgemma",
  "codeRepository": "https://github.com/google-health/medgemma",
