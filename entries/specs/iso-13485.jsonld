  "identifier": "iso-13485",
  "name": "ISO 13485:2016",
  "alternateName": [
    "ISO 13485",
    "Medical devices — Quality management systems — Requirements for regulatory purposes"
  ],
  "description": "The international quality management system (QMS) standard for organisations in the medical device lifecycle — design, production, storage, distribution, installation, and servicing. Harmonised with EU MDR (2017/745) and IVDR (2017/746); compliance is a prerequisite for CE marking. Recognised by regulatory bodies in the EU, Canada (MDSAP), Australia (TGA), and Japan (JPAL). Covers document control, design and development controls, purchasing controls, production controls, and post-market surveillance. Applies to manufacturers of hardware, software, and AI-enabled medical devices. Published by ISO. Paid standard — purchase required.",
  "url": "https://www.iso.org/standard/59752.html",
