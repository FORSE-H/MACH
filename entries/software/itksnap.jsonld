  "identifier": "itksnap",
  "name": "ITK-SNAP",
  "description": "Widely used open-source application for interactive segmentation of 3D medical images — providing user-guided active contour and manual segmentation tools for anatomical structures in MRI, CT, and other volumetric imaging data. Cited in over 8,000 academic papers, making it one of the most referenced medical imaging tools in research. Developed for 20+ years by Paul Yushkevich's group at the University of Pennsylvania with NIH/NLM funding. C++-based cross-platform application (Windows, macOS, Linux). GPL-3.0, 431 stars, 121 forks, v4.4.0-beta2 (August 2025).",
  "url": "http://www.itksnap.org/",
  "codeRepository": "https://github.com/pyushkevich/itksnap",
  "license": "GPL-3.0-only",
  "version": "4.4.0-beta2",
  "dateModified": "2025-08-27",
