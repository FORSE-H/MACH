      "@type": "Organization",
      "name": "Stanford MIMI (Medical Imaging and Machine Intelligence) Lab",
      "url": "https://aimi.stanford.edu/"
    }
  ],
  "mach:governance": "academic",
  "mach:category": "software",
  "mach:deploymentContext": [
    "self-hosted",
    "embedded-library"
  ],
  "mach:intendedUse": "A research framework for flagging factual inconsistencies in AI-generated medical text; a safety-screening aid, not a substitute for clinician review.",
  "mach:editorialReviewedAt": "2026-11-22",
  "schema:comment": "Evaluation/fine-tuning can optionally route text through third-party APIs (OpenAI/Anthropic/Gemini) per the config examples; using that path would send inputs off-premises. The MedVAL-4B model and MedVAL-Bench dataset are on Hugging Face.",
