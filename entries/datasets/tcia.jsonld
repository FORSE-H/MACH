  "identifier": "tcia",
  "name": "The Cancer Imaging Archive",
  "alternateName": [
    "TCIA"
  ],
  "description": "The primary open repository for de-identified cancer medical imaging data, hosted by the National Cancer Institute. Organises images by cancer type, imaging modality (CT, MRI, PET, digital pathology/whole-slide), and research focus — primarily in DICOM format. Includes associated clinical, genomic, and treatment data for many collections. Covers radiology and histopathology collections used in AI/ML research and clinical trials. Accessed via the NBIA REST API or the tcia_utils Python package. ~250+ collections. CC-BY 3.0 with per-collection citation requirements. Operated by NCI/UAMS.",
  "url": "https://www.cancerimagingarchive.net/",
  "license": "CC-BY-3.0",
  "keywords": [
    "cancer-imaging",
    "dicom",
    "radiology",
    "pathology",
    "whole-slide-imaging",
    "ct",
    "mri",
    "pet",
    "nci",
    "oncology",
    "open-data",
    "benchmark"
  ],
  "author": [
    {
      "@type": "Organization",
      "name": "National Cancer Institute / University of Arkansas for Medical Sciences",
      "url": "https://www.cancer.gov/"
    }
  ],
  "mach:governance": "government",
  "mach:category": "datasets-benchmarks",
  "mach:maturity": "production",
  "mach:deploymentContext": [
    "cloud-only"
  ],
  "mach:judgement": "Adopt",
  "mach:judgementReason": "The canonical open cancer imaging archive — the standard source for de-identified CT, MRI, PET, and whole-slide imaging datasets used in medical AI research. NCI/NIH governed, CC-BY 3.0, DICOM-native, REST API accessible. Virtually every medical imaging AI paper that evaluates on public data uses TCIA collections. Pairs with NCI Imaging Data Commons (IDC) in the MACH catalog: TCIA is the collection-level archive; IDC provides cloud-native BigQuery access to the same data.",
  "mach:editorialReviewedAt": "2026-05-14",
  "mach:evidence": [
