  "identifier": "scgpt",
  "name": "scGPT",
  "alternateName": [
    "single-cell GPT"
  ],
  "description": "Generative foundation model for single-cell multi-omics analysis. Pre-trained on 33 million normal human cells from CellXGene across brain, blood, heart, lung, kidney, and pan-cancer tissue. Enables cell type annotation, scRNA-seq integration, gene regulatory network inference, and reference mapping. Supports fine-tuning on specific cell populations and zero-shot cell embedding for large-scale similarity searches. MIT, v0.2.4.",
  "url": "https://github.com/bowang-lab/scGPT",
