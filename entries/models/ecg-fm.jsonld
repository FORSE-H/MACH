  "mach:weightsLicense": "MIT",
  "mach:trainingDataSummary": "Pre-trained on MIMIC-IV-ECG and PhysioNet ECG datasets using W2V+CMSC+RLM self-supervised learning. 90.9M parameter wav2vec 2.0 architecture adapted for ECG signals.",
  "mach:intendedUse": "ECG signal analysis for research — arrhythmia detection, cardiac classification, downstream fine-tuning for clinical prediction tasks. Checkpoints on HuggingFace. Not a cleared medical device.",
  "mach:aiActRiskClass": "high-risk-candidate",
  "mach:governance": "academic",
