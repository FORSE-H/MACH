  "identifier": "comp2comp",
  "name": "Comp2Comp",
  "alternateName": [
    "Computed tomography to body composition"
  ],
  "description": "Library that extracts clinical body-composition insights from CT scans through chained inference pipelines: spine labelling, muscle and adipose tissue quantification (T12-L5), bone mineral density, aortic calcification, abdominal aortic aneurysm, and liver/spleen/pancreas and contrast-phase analysis. Apache-2.0 licensed, Python, from the Stanford MIMI Lab. Research software — its bone-mineral-density output is explicitly labelled NOT FDA cleared.",
  "url": "https://github.com/StanfordMIMI/Comp2Comp",
  "codeRepository": "https://github.com/StanfordMIMI/Comp2Comp",
  "relatedLink": [
    "https://arxiv.org/abs/2302.06568"
  ],
  "license": "Apache-2.0",
  "programmingLanguage": [
    "Python"
  ],
  "applicationCategory": "Medical imaging",
