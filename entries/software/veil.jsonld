  "identifier": "veil",
  "name": "Veil",
  "alternateName": [
    "MAYA Veil"
  ],
  "description": "Open-source Chrome extension for real-time PII detection and redaction before submission to AI chat interfaces. Monitors text inputs and identifies sensitive entities (names, emails, SSNs, credit cards) using a locally-run GLiNER2 ONNX model — no data leaves the user's machine. MIT-licensed open-source offering from MAYA Data Privacy, whose commercial products (AppSafe, FileSafe, AISafe) target enterprise HIPAA and GDPR compliance. Directly addresses the challenge of safe AI tool use in clinical and administrative healthcare settings where patient or staff data may be inadvertently included in prompts.",
  "url": "https://www.mayadataprivacy.com/",
  "codeRepository": "https://github.com/MAYA-DATA-PRIVACY/Veil",
  "license": "MIT",
  "version": "1.2.8",
  "dateModified": "2026-04-04",
