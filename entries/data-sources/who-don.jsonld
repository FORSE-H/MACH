  "identifier": "who-don",
  "name": "WHO Disease Outbreak News",
  "alternateName": [
    "WHO DON",
    "Disease Outbreak News"
  ],
  "description": "Official WHO publication series reporting confirmed and potential acute public health events of international concern across all hazards — infectious disease outbreaks, antimicrobial resistance events, foodborne illness, and chemical or radiological incidents. Reports are authoritative, expert-reviewed, and published when events meet WHO criteria for international significance. Programmatically accessible via a WHO REST API and RSS feed. Coverage is conservative by design: DON reports represent events where WHO has confirmed public disclosure is warranted, not an exhaustive list of all monitored events. Used as the ground-truth reference for international outbreak surveillance in academic research and public health intelligence systems.",
  "url": "https://www.who.int/emergencies/disease-outbreak-news",
  "relatedLink": [
    "https://www.who.int/api/news/diseaseoutbreaknews/sfhelp",
    "https://www.who.int/data/gho/info/gho-odata-api"
  ],
  "license": "CC-BY-NC-SA-3.0-IGO",
  "keywords": [
    "outbreak-surveillance",
    "infectious-disease",
    "public-health",
    "epidemiology",
