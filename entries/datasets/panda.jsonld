  "identifier": "panda",
  "name": "PANDA",
  "alternateName": [
    "Prostate cANcer graDe Assessment Challenge"
  ],
  "description": "The largest publicly available whole-slide imaging dataset, containing ~11,000 H&E-stained prostate biopsy WSIs with Gleason grading annotations from Radboud University Medical Center and Karolinska Institute. Designed to evaluate automated Gleason grading — the primary clinical severity score for prostate cancer. Approximately 8 times the size of CAMELYON17. Originally run as a Kaggle competition (2020), now available for ongoing scientific research. Dataset available via Kaggle. CC BY-SA-NC 4.0 (non-commercial use only). Organised by Radboudumc, Karolinska Institute, and Tampere University.",
  "url": "https://panda.grand-challenge.org/",
  "codeRepository": "https://www.kaggle.com/c/prostate-cancer-grade-assessment",
  "license": "CC-BY-NC-SA-4.0",
  "keywords": [
    "digital-pathology",
    "whole-slide-imaging",
    "prostate-cancer",
    "gleason-grading",
    "wsi",
    "computational-pathology",
    "benchmark",
    "h-and-e",
    "radboudumc",
    "karolinska",
    "kaggle"
  ],
  "author": [
    {
      "@type": "Organization",
      "name": "Radboud University Medical Center / Karolinska Institute / Tampere University",
      "url": "https://panda.grand-challenge.org/"
    }
  ],
  "schema:distribution": [
    {
      "@type": "schema:DataDownload",
      "schema:contentUrl": "https://www.kaggle.com/competitions/prostate-cancer-grade-assessment/data",
      "schema:encodingFormat": "image/tiff"
    }
  ],
  "mach:governance": "academic",
  "mach:category": "datasets-benchmarks",
  "mach:maturity": "production",
  "mach:deploymentContext": [
    "self-hosted",
    "cloud-only"
  ],
  "mach:judgement": "Assess",
  "mach:judgementReason": "The largest public prostate pathology WSI dataset — 11,000 slides with expert Gleason grading from two leading medical centres, widely used to train and benchmark prostate cancer AI. CC BY-SA-NC 4.0: free for research but non-commercial restriction limits use in commercial AI development pipelines. Requires Kaggle account for data access. Assess rather than Adopt due to the NC licence clause and Kaggle access dependency. Essential for academic prostate pathology AI research.",
  "mach:editorialReviewedAt": "2026-05-14",
