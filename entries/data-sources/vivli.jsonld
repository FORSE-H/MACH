  "identifier": "vivli",
  "name": "Vivli",
  "alternateName": [
    "Vivli Center for Global Clinical Research Data"
  ],
  "description": "Global clinical trial data sharing platform operated as an independent nonprofit. Hosts 8,000+ clinical trials representing 5.2 million participants, contributed by 55+ member organisations including Pfizer, Roche, GSK, Novartis, NIH HEAL Initiative, and academic institutions including Harvard, Johns Hopkins, and Stanford. Data access is controlled: requestors submit a research proposal reviewed by the contributing organisation and an Independent Review Panel (IRP), then execute a non-negotiable Data Use Agreement (DUA). Implements the Five Safes Framework for data protection. Endorsed by NIH as an approved generalist repository for data sharing under the NIH Data Management and Sharing Policy. Search interface at search.vivli.org; no public API.",
  "url": "https://vivli.org",
  "relatedLink": [
    "https://search.vivli.org"
  ],
  "license": "custom",
  "mach:licenseUrl": "https://vivli.org/resources/vivli-data-use-agreement/",
  "mach:licenseVerified": false,
