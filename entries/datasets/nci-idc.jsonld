  "identifier": "nci-idc",
  "name": "NCI Imaging Data Commons",
  "alternateName": [
    "IDC"
  ],
  "description": "Cloud-native NCI cancer imaging platform providing programmatic access to 176 collections, 85,682 cases, 1,032,911 image series, and 99+ TB of radiology and digital pathology data hosted on Google Cloud Storage. All images are in DICOM format and queryable via Google BigQuery, the idc-index Python package, or an interactive portal. Integrates with TCIA collections and adds cloud-scale query capabilities. Data Release v24.0 (April 2026). Developed by NCI with Google Cloud support. Dataset-specific NCI Data Use Agreements apply.",
  "url": "https://portal.imaging.datacommons.cancer.gov/",
  "codeRepository": "https://github.com/ImagingDataCommons/idc-index",
  "version": "24.0",
  "dateModified": "2026-04-27",
  "license": "CC-BY-4.0",
