  "identifier": "torchio",
  "name": "TorchIO",
  "description": "Open-source Python library for efficient loading, preprocessing, augmentation, and patch-based sampling of 3D medical images in deep learning pipelines built with PyTorch. Provides spatial transforms (random flips, affine, elastic deformation), intensity transforms (bias field simulation, MRI k-space motion artifact simulation, noise, normalisation), and label map operations — including domain-specific MRI augmentations not found in general-purpose vision libraries. Supports standard medical image formats via SimpleITK/ITK. Published in Computer Methods and Programs in Biomedicine (2021). Originally developed at UCL and King's College London; now community-maintained under the torchio-project organisation. Apache 2.0 licensed, 2.4k stars, v1.0.2.",
  "url": "https://torchio.org/",
  "codeRepository": "https://github.com/fepegar/torchio",
  "license": "Apache-2.0",
  "version": "1.0.2",
  "dateModified": "2026-04-01",
