  "identifier": "hito",
  "name": "HITO",
  "alternateName": [
    "Health IT Ontology",
    "Health Information Technology Ontology"
  ],
  "description": "OWL ontology for systematically describing and classifying health IT application systems and software products. Defines classes and relationships for software features, enterprise functions, programming languages, licenses, and user groups, enabling structured documentation of libre/free and open-source software (LIFOSS) for medicine and healthcare. Published as Linked Open Data with a SPARQL endpoint, RDF browser, and downloadable Turtle/N-Triples distributions. Data is compiled from spreadsheets and linked data sources via an automated build pipeline with SHACL validation. CC0-licensed (public domain), making it freely reusable as a vocabulary or dataset.",
  "url": "https://hitontology.eu/",
  "codeRepository": "https://github.com/hitontology/ontology",
  "license": "CC0-1.0",
  "version": "24.11",
  "dateModified": "2024-11-05",
