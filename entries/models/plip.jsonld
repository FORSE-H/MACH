  "identifier": "plip",
  "name": "PLIP",
  "alternateName": [
    "Pathology Language and Image Pre-Training"
  ],
  "description": "The first vision-language foundation model for computational pathology — a CLIP-based contrastive model fine-tuned on 208,414 pathology image-text pairs sourced from medical Twitter posts. Enables zero-shot tissue and cancer classification from natural language prompts without task-specific training. Evaluated across multiple pathology classification tasks. Published in Nature Medicine 2023. Model weights hosted on HuggingFace (vinid/plip), 75k+ monthly downloads. 376 stars. Research use only.",
  "url": "https://huggingface.co/vinid/plip",
  "codeRepository": "https://github.com/PathologyFoundation/plip",
