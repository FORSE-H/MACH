  "identifier": "monai-deploy",
  "name": "MONAI Deploy",
  "description": "Framework for packaging, testing, and deploying medical AI applications into clinical production environments, part of the MONAI ecosystem. Provides an Application Package specification, an App SDK for containerising trained models, an Informatics Gateway for DICOM and FHIR integration with hospital systems, a Workflow Manager for orchestration, and MONAI Deploy Express for end-to-end local testing. Designed to bridge the gap between research model development (MONAI core) and clinical production deployment in radiology and beyond. Apache 2.0, 117 stars, v0.6.1 (pre-release).",
  "url": "https://monai.io/deploy.html",
  "codeRepository": "https://github.com/Project-MONAI/monai-deploy",
  "license": "Apache-2.0",
  "version": "0.6.1",
