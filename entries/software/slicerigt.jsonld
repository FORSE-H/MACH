  "identifier": "slicerigt",
  "name": "SlicerIGT",
  "alternateName": [
    "Slicer Image-Guided Therapy"
  ],
  "description": "3D Slicer extension providing a toolkit for image-guided interventions (IGT). Offers real-time instrument tracking, ultrasound and needle guidance, surgical navigation, and OpenIGTLink-based integration with tracking hardware and imaging devices. Used in research and clinical prototype workflows for needle biopsy, catheter placement, and intraoperative navigation. Developed by the PerkLab at Queen's University.",
  "url": "https://www.slicerigt.org/wp/",
