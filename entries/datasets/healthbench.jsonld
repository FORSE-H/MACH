  "identifier": "healthbench",
  "name": "HealthBench",
  "alternateName": [
    "OpenAI HealthBench"
  ],
  "description": "Physician-curated benchmark for evaluating large language models on realistic health conversations. Contains 5,000 multi-turn conversations between a model and a user or healthcare professional, each graded by 48,562 unique rubric criteria written by 262 physicians who have practiced in 60 countries. Covers general health, emergency medicine, chronic disease, mental health, rare disease, and global health contexts. Evaluation code ships in the openai/simple-evals repository. Unlike multiple-choice benchmarks, HealthBench uses open-ended, graded rubrics to assess both accuracy and safety of model responses. Published by OpenAI in May 2025.",
  "url": "https://openai.com/index/healthbench/",
  "codeRepository": "https://github.com/openai/simple-evals",
  "relatedLink": [
    "https://arxiv.org/abs/2505.08775",
    "https://github.com/openai/simple-evals/blob/main/healthbench_eval.py",
    "https://huggingface.co/datasets/openai/healthbench-professional"
  ],
  "mach:huggingFaceUrl": "https://huggingface.co/datasets/openai/healthbench",
  "license": "MIT",
