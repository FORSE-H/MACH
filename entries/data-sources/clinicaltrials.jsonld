  "identifier": "clinicaltrials",
  "name": "ClinicalTrials.gov",
  "description": "The world's largest public registry of clinical studies — 500,000+ registered trials covering interventional and observational studies, eligibility criteria, outcomes, results, and status. Maintained by NLM/NIH. REST API v2 (launched 2024) provides structured JSON access with full-text search, field filters, and pagination. Bulk download available as ZIP. Data updated daily. Public domain (US government work). OpenAPI-compliant with Swagger documentation. The authoritative source for clinical trial data used in evidence synthesis, trial matching AI, and research landscape analysis.",
  "url": "https://clinicaltrials.gov/",
  "codeRepository": "https://clinicaltrials.gov/data-api/api",
  "license": "CC0-1.0",
  "keywords": [
    "clinical-trials",
    "registry",
    "research",
    "interventional-studies",
    "eligibility-criteria",
    "outcomes",
    "rest-api",
    "nlm",
