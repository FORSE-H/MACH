  "identifier": "cornerstone3d",
  "name": "Cornerstone3D",
  "alternateName": [
    "cornerstone.js",
    "CornerstoneJS"
  ],
  "description": "High-performance TypeScript framework for building web-based medical imaging applications, providing the rendering engine underlying the OHIF Viewer. Delivers GPU-accelerated 2D/3D volume rendering via WebGL and WebAssembly, multiplanar reconstruction, segmentation tools, and measurement annotations. DICOMweb-native with customisable image and metadata loaders. Maintained by the Open Health Imaging Foundation (OHIF) as the foundational layer for web medical imaging development.",
  "url": "https://www.cornerstonejs.org",
  "codeRepository": "https://github.com/cornerstonejs/cornerstone3D",
  "license": "MIT",
  "version": "4.16.0",
  "dateModified": "2026-02-11",
