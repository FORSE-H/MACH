  "identifier": "dhis2",
  "name": "DHIS2",
  "alternateName": [
    "District Health Information Software 2"
  ],
  "description": "The world's largest health management information system (HMIS) platform, deployed in over 80 countries and used by billions of people's health records. Provides flexible data capture, validation, analytics, dashboards, pivot tables, GIS visualisation, and a RESTful API. Supports FHIR interoperability and covers health surveillance, disease reporting, supply chain, immunisation tracking, and electronic medical records. Led by the HISP Centre at the University of Oslo and supported by a global HISP network across Africa, Asia, the Middle East, and the Americas. Funded by WHO, World Bank, Gates Foundation, Gavi, UNICEF, and Wellcome Trust. Recognised as a Digital Public Good. BSD 3-Clause, 14,826 commits, Java-based.",
  "url": "https://dhis2.org/",
  "codeRepository": "https://github.com/dhis2/dhis2-core",
  "license": "BSD-3-Clause",
