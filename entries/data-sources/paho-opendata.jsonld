  "name": "PAHO Open Data Portal",
  "alternateName": [
    "PAHO Data",
    "Pan American Health Organization Open Data",
    "opendata.paho.org"
  ],
  "description": "Open data portal of the Pan American Health Organization (PAHO), the WHO regional office for the Americas. Provides 140+ core health indicators from 1995 to present with demographic disaggregation across all countries and territories in the Americas. Topics include communicable diseases (dengue, malaria, HIV, TB, influenza, COVID-19), non-communicable diseases, immunisation coverage, maternal and child health, health workforce, environmental health, and SDG health targets. Data is accessible via interactive dashboards and downloadable in CSV/Excel formats. Licensed under CC BY-NC 3.0 IGO — free for non-commercial and research use.",
  "url": "https://opendata.paho.org/",
  "relatedLink": [
    "https://www.paho.org/en/information-systems",
    "https://iris.paho.org/"
  ],
  "license": "CC-BY-NC-3.0-IGO",
