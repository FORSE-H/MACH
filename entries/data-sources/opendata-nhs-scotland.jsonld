  "identifier": "opendata-nhs-scotland",
  "name": "Scottish Health and Social Care Open Data",
  "alternateName": [
    "opendata.nhs.scot",
    "PHS Open Data"
  ],
  "description": "Open data platform managed by Public Health Scotland providing 104 health and social care datasets covering Scotland's NHS. Topics include emergency department waiting times, hospital activity, COVID-19 vaccination and surveillance, maternity and births, cancer, mental health, and social care. Data is organised under 4 themes and 23 groups, with regular quarterly and annual updates. Programmatic access via CKAN API. R client available via the phsopendata package on CRAN. All data released under Open Government Licence v3.0.",
  "url": "https://www.opendata.nhs.scot/",
  "relatedLink": [
    "https://www.opendata.nhs.scot/api/3/action/package_list",
    "https://github.com/Public-Health-Scotland/phsopendata"
  ],
  "license": "OGL-UK-3.0",
  "mach:licenseUrl": "https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/",
  "mach:licenseVerified": true,
