  "identifier": "clinvar",
  "name": "ClinVar",
  "description": "Freely accessible public archive of human genomic variants classified for disease and drug response, maintained by NCBI/NLM/NIH. Contains 4.5M+ distinct variants from 6.8M+ submissions by 3,386 submitters across 95 countries — including clinical laboratories, expert panels, research institutions, and patient registries. Records are structured around two types: VCV (variant-centric) and RCV (variant-condition pairs), both carrying standardised pathogenicity classifications (Pathogenic, Likely Pathogenic, VUS, Likely Benign, Benign) and star-rated review status reflecting evidence quality. Supports HGVS notation, ClinGen expert panel curation, and Mondo/OMIM disease mapping. Accessible via web interface, bulk FTP download, and NCBI E-utilities REST API. Public domain (US government work). The authoritative open reference for germline variant interpretation used in clinical genetics, precision oncology, and genomic medicine pipelines.",
  "url": "https://www.ncbi.nlm.nih.gov/clinvar/",
  "codeRepository": "https://www.ncbi.nlm.nih.gov/clinvar/docs/api_http/",
  "relatedLink": [
    "https://ftp.ncbi.nlm.nih.gov/pub/clinvar/",
    "https://www.ncbi.nlm.nih.gov/clinvar/docs/ftp_primer/"
  ],
  "license": "CC0-1.0",
