  "identifier": "deepvariant",
  "name": "DeepVariant",
  "alternateName": [
    "Google DeepVariant"
  ],
  "description": "Deep learning-based DNA variant caller from Google Health. Processes aligned sequencing reads (BAM/CRAM), generates pileup image tensors, and classifies genetic variants using a convolutional neural network, outputting VCF/gVCF files. Supports Illumina, PacBio, Oxford Nanopore, and other sequencing platforms for whole genome and whole exome analysis. Includes DeepTrio for trio/duo variant calling. Won the 2020 PrecisionFDA Truth Challenge V2. BSD-3-Clause, 3.7k stars, v1.10.0 (March 2026), Docker-containerised, GPU/TPU acceleration available.",
  "url": "https://github.com/google/deepvariant",
  "codeRepository": "https://github.com/google/deepvariant",
