  "name": "GNU Health",
  "alternateName": [
    "GNU Health HMIS"
  ],
  "description": "Libre hospital and health information system providing over 40 standard-based packages covering primary care, obstetrics, pediatrics, laboratory management, diagnostics, and health administration. Developed by GNU Solidario, an NGO founded by Luis Falcón MD, with a mission rooted in social medicine and equitable healthcare access. Production deployments span Africa (Gabon, Cameroon, Gambia), Asia (India/AIIMS, Laos/Mahosot Hospital, Pakistan), Latin America (Argentina, Mexico/Cruz Roja Mexicana), the Caribbean (Jamaica Ministry of Health), and Europe. Recognised as a Digital Public Good, GNU Official Package, and FSF Award for Projects of Social Benefit recipient. Python-based, GPL v3+, self-hosted, v5.0.7. Hosted on Codeberg — not GitHub.",
  "url": "https://www.gnuhealth.org/",
  "codeRepository": "https://codeberg.org/gnuhealth/his",
