  "identifier": "amsterdamumc-db",
  "name": "AmsterdamUMCdb",
  "alternateName": [
    "Amsterdam University Medical Centers Database"
  ],
  "description": "The first freely accessible European intensive care database. Contains de-identified clinical data from 23,106 ICU and high-dependency unit admissions (20,109 unique patients) at Amsterdam UMC from 2003–2016, totalling approximately 1 billion clinical observations including vital signs, laboratory values, medication records, and device data. Released in OMOP Common Data Model v5.4 (v1.5.0). Accompanied by a Python package with fluid balance calculations, dictionary lookups, and data visualisation utilities. Data access requires a short application via the Amsterdam Medical Data Science website. Code and tooling are MIT licensed. From the Intensive Care Department at Amsterdam UMC, with Paul Elbers as corresponding author.",
  "url": "https://amsterdammedicaldatascience.nl",
  "codeRepository": "https://github.com/AmsterdamUMC/AmsterdamUMCdb",
  "license": "MIT",
  "softwareVersion": "1.5.0",
