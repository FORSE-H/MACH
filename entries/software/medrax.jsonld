  "identifier": "medrax",
  "name": "MedRAX",
  "alternateName": [
    "Medical Reasoning Agent for Chest X-ray"
  ],
  "description": "Agentic AI framework for chest X-ray (CXR) interpretation that dynamically orchestrates multiple specialist models — visual QA (CheXagent, LLaVA-Med), segmentation (MedSAM, PSPNet), grounding (Maira-2), report generation (SwinV2), disease classification (DenseNet-121) — via LangChain and LangGraph. Addresses complex multi-step clinical queries without additional training. Introduces ChestAgentBench: 2,500 complex CXR queries across 7 reasoning categories for standardised evaluation. ICML 2025. Apache-2.0.",
  "url": "https://github.com/bowang-lab/MedRAX",
  "codeRepository": "https://github.com/bowang-lab/MedRAX",
  "license": "Apache-2.0",
  "relatedLink": [
    "https://arxiv.org/abs/2502.02673",
    "https://huggingface.co/datasets/wanglab/chest-agent-bench"
  ],
  "programmingLanguage": [
    "Python"
  ],
