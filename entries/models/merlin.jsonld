    }
  ],
  "mach:governance": "academic",
  "mach:category": "ai-ml-models",
  "mach:deploymentContext": [
    "self-hosted",
    "embedded-library"
  ],
  "mach:weightsLicense": "MIT (model weights released on Hugging Face under the same licence as the code).",
  "mach:trainingDataSummary": "Paired abdominal CT volumes, structured EHR phenotypes, and unstructured radiology reports (the Merlin Abdominal CT Dataset).",
  "mach:intendedUse": "A research foundation model for CT-based representation learning and downstream tasks (classification, risk prediction, report generation) — not intended for direct clinical use without further validation.",
  "mach:accessModel": "open-weights",
  "mach:editorialReviewedAt": "2026-11-22",
  "schema:comment": "Segmentation is handled via a separate Merlin-nnU-Net integration repo. The Merlin Abdominal CT Dataset is access-gated through Stanford AIMI (data-use agreement), separate from the MIT-licensed code and weights.",
