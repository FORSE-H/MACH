  "identifier": "monuseg",
  "name": "MoNuSeg",
  "alternateName": [
    "Multi-organ Nuclei Segmentation Challenge"
  ],
  "description": "MICCAI 2018 grand challenge dataset for nucleus instance segmentation in H&E-stained histology images across multiple organs (breast, liver, kidney, prostate, bladder, colon, stomach). 30 training images (21,623 annotated nuclei) and 14 test images from diverse patients and hospitals. Expert-annotated nucleus boundaries. Published in IEEE Transactions on Medical Imaging 2020 (Kumar et al.). The primary multi-organ nucleus segmentation benchmark; used to train and evaluate StarDist, CellViT, and most nucleus segmentation models. Access via Grand Challenge registration.",
  "url": "https://monuseg.grand-challenge.org/",
  "license": "custom",
  "keywords": [
    "digital-pathology",
    "nucleus-segmentation",
    "instance-segmentation",
    "multi-organ",
    "h-and-e",
    "benchmark",
    "miccai",
    "breast-cancer",
    "prostate",
    "colon"
  ],
