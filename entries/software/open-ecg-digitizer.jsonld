  "identifier": "open-ecg-digitizer",
  "name": "Open-ECG-Digitizer",
  "description": "Tool for converting scanned or photographed paper ECGs into digital time-series data. Uses a U-Net segmentation model with perspective correction to extract waveforms from images, enabling retrospective digitisation of historical paper ECG archives. Includes a training dataset published on HuggingFace under Apache-2.0.",
  "url": "https://github.com/Ahus-AIM/Open-ECG-Digitizer",
