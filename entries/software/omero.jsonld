  "name": "OMERO",
  "alternateName": [
    "Open Microscopy Environment Remote Objects",
    "OME Server"
  ],
  "description": "Open-source platform for managing, visualising, and analysing microscopy image data. Supports 150+ imaging formats, centralised storage, web and desktop clients, scripting APIs (Python, Java, MATLAB), and collaborative annotation. Widely deployed in academic research institutes and hospital imaging core facilities.",
