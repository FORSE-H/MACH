  "name": "OHIF Viewers",
  "alternateName": [
    "OHIF Viewer",
    "Open Health Imaging Foundation Viewer"
  ],
  "description": "Zero-footprint, web-based medical image viewer from the Open Health Imaging Foundation (OHIF). A configurable progressive web application with built-in DICOMweb support, 2D/3D rendering, multiplanar reconstruction, segmentation, measurement tracking, structured reports, and whole slide microscopy. Built on Cornerstone3D (WebGL/WebAssembly), extensible via a plugin architecture for custom clinical workflows. Widely embedded in research infrastructure including NCI Imaging Data Commons. NIH/NCI ITCR-funded.",
  "url": "https://ohif.org",
