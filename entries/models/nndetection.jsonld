  "mach:weightsLicense": "Apache-2.0",
  "mach:trainingDataSummary": "Framework only — trains from scratch on user-provided detection datasets. Benchmark results reported on 12 publicly available medical detection datasets including LUNA16 (lung nodules), LIDC-IDRI, and others.",
  "mach:intendedUse": "3D medical object detection research — lung nodule detection, lesion localisation, anatomical landmark detection. Research use. Not a cleared medical device.",
  "mach:aiActRiskClass": "high-risk-candidate",
  "mach:evaluationReference": [
    {
      "@type": "schema:ScholarlyArticle",
      "url": "https://arxiv.org/abs/2106.00882",
      "schema:name": "nnDetection: A Self-configuring Method for Medical Object Detection. MICCAI 2021."
    }
