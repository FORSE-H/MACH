  "identifier": "slicer-3d",
  "name": "3D Slicer",
  "description": "Comprehensive open-source platform for medical image visualisation and analysis, with a strong focus on research and clinical translation. Supports segmentation, registration, tractography, 3D rendering, image-guided therapy, and multi-modal imaging (MRI, CT, PET, ultrasound). Extensible via a large ecosystem of community modules. Built on VTK and ITK, with a Python scripting interface. Widely used in academic medical centres and NIH-funded imaging research worldwide. BSD-style licence, 2.5k stars, 728 forks, v5.10.0 (March 2026). Maintained by Brigham and Women's Hospital, Kitware, and NIH-funded contributors.",
  "url": "https://www.slicer.org/",
  "codeRepository": "https://github.com/Slicer/Slicer",
  "license": "BSD-2-Clause",
  "version": "5.10.0",
  "dateModified": "2026-03-19",
