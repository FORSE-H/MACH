  "identifier": "medsam",
  "name": "MedSAM",
  "alternateName": [
    "Segment Anything in Medical Images"
  ],
  "description": "Universal medical image segmentation model adapting Meta's Segment Anything Model (SAM) to 30+ imaging modalities including CT, MRI, ultrasound, X-ray, endoscopy, and microscopy. Trained on over 1 million image-mask pairs across diverse anatomical structures. Requires only a bounding box prompt — no per-dataset retraining. Ships with LiteMedSAM (10× faster lightweight variant), a 3D Slicer plugin, and CLI/GUI/notebook inference interfaces. The de-facto open foundation for promptable medical image segmentation since the Nature Communications 2024 paper.",
  "url": "https://github.com/bowang-lab/MedSAM",
  "codeRepository": "https://github.com/bowang-lab/MedSAM",
  "license": "Apache-2.0",
  "softwareVersion": "1.0.0",
  "programmingLanguage": [
    "Python"
  ],
  "keywords": [
    "medical-image-segmentation",
