  "identifier": "ctakes",
  "name": "Apache cTAKES",
  "alternateName": [
    "cTAKES",
    "clinical Text Analysis and Knowledge Extraction System"
  ],
  "description": "Open-source NLP platform for extracting clinical information from unstructured clinical text — radiology reports, discharge summaries, and EHR notes. Identifies and normalises clinical concepts including medications, diagnoses, procedures, anatomical terms, and temporal events. Supports HL7 CDA, FHIR, SNOMED-CT, and RxNorm. Combines rule-based and machine learning approaches with modular UIMA-based components. Originally developed at Mayo Clinic; now an Apache Software Foundation top-level project. Apache 2.0, v6.0.0 (Sept 2024), Java-based.",
  "url": "https://ctakes.apache.org/",
  "codeRepository": "https://github.com/apache/ctakes",
  "license": "Apache-2.0",
  "version": "6.0.0",
