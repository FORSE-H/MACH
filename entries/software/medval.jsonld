  "identifier": "medval",
  "name": "MedVAL",
  "description": "Self-supervised framework that validates AI-generated medical text against its source input using language models, assessing factual consistency and assigning a risk grade and deployment-safety determination across tasks such as dialogue-to-note, report-to-impression, and report simplification. Ships the MedVAL-4B model and the MedVAL-Bench dataset on Hugging Face. MIT-licensed, Python, from the Stanford MIMI Lab. Published in npj Digital Medicine 2026.",
  "url": "https://github.com/StanfordMIMI/MedVAL",
  "codeRepository": "https://github.com/StanfordMIMI/MedVAL",
  "relatedLink": [
    "https://doi.org/10.1038/s41746-026-03084-5",
    "https://huggingface.co/stanfordmimi/MedVAL-4B",
    "https://huggingface.co/datasets/stanfordmimi/MedVAL-Bench"
  ],
  "license": "MIT",
  "programmingLanguage": [
    "Python"
  ],
  "applicationCategory": "Clinical NLP",
  "keywords": [
    "clinical-nlp",
    "text-validation",
    "factual-consistency",
    "large-language-models",
    "evaluation",
    "patient-safety",
