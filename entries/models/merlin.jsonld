  "identifier": "merlin",
  "name": "Merlin",
  "description": "3D vision-language foundation model for abdominal computed tomography, pretrained on paired CT volumes, structured electronic health records, and unstructured radiology reports. Supports image and text embeddings, phenotype classification, five-year disease-risk prediction, and radiology report generation. Published in Nature 2026. Code and model weights are MIT-licensed and released on Hugging Face; the accompanying Merlin Abdominal CT Dataset is distributed separately through Stanford AIMI under a data-use agreement. Stanford MIMI Lab.",
  "url": "https://huggingface.co/stanfordmimi/Merlin",
  "codeRepository": "https://github.com/StanfordMIMI/Merlin",
  "relatedLink": [
    "https://doi.org/10.1038/s41586-026-10181-8",
    "https://arxiv.org/abs/2406.06512",
    "https://github.com/ashwinkumargb/Merlin-nnUNet"
  ],
  "license": "MIT",
  "programmingLanguage": [
    "Python"
  ],
