  "identifier": "tcga",
  "name": "The Cancer Genome Atlas",
  "alternateName": [
    "TCGA"
  ],
  "description": "Landmark cancer genomics program that comprehensively characterised the molecular landscape of 33 cancer types across 20,000+ primary tumour and matched normal tissue samples — generating over 2.5 petabytes of genomic, epigenomic, transcriptomic, proteomic, and clinical data, plus whole-slide pathology images and radiology imaging. Jointly run by NCI and NHGRI (2006–2018). Data access via the GDC (Genomic Data Commons) portal and API. Most data is open access under the NIH Genomic Data Sharing Policy; a subset requires dbGaP controlled-access approval. One of the most-cited datasets in cancer biology and medical AI.",
  "url": "https://portal.gdc.cancer.gov/",
  "codeRepository": "https://github.com/NCI-GDC/gdc-client",
  "license": "custom",
