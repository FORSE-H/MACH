  "identifier": "weasis",
  "name": "Weasis",
  "description": "Web-based DICOM viewer for advanced medical imaging and seamless PACS integration. Supports most DICOM file types including CT, MRI, PET, ultrasound, and X-ray. Features include measurement and annotation tools, 3D volume rendering, multi-planar reconstruction, and DICOMweb/WADO integration. Runs on Windows, macOS, and Linux as a desktop application. Dual-licensed EPL 2.0 / Apache 2.0. Java-based, 1.2k stars, 359 forks, v4.6.6 (December 2025).",
  "url": "https://weasis.org/",
  "codeRepository": "https://github.com/nroduit/Weasis",
  "license": "EPL-2.0",
  "version": "4.6.6",
  "dateModified": "2025-12-29",
