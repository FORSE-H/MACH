  "identifier": "openalex",
  "name": "OpenAlex",
  "description": "Free, fully open academic knowledge graph covering 250M+ scholarly works, 250M+ authors, 100K+ institutions (with ROR IDs), and 30K+ journals. Successor to Microsoft Academic Graph (MAG), maintained by OurResearch (non-profit). CC0 data licence — bulk snapshots freely downloadable from S3. REST API requires no authentication (polite pool with email in User-Agent header). Covers all academic disciplines. Key signals for research software discovery: citation counts, author institution affiliations (ROR-resolved), funder metadata, open-access status, and concept/topic tags. Used by MACH as the primary scholarly enrichment source for governance inference (ROR IDs), citation scoring, and linking catalog entries to their foundational papers.",
  "url": "https://openalex.org",
  "codeRepository": "https://github.com/ourresearch/openalex-api-tutorials",
  "relatedLink": [
    "https://api.openalex.org",
    "https://docs.openalex.org"
  ],
  "license": "CC0-1.0",
  "mach:licenseUrl": "https://docs.openalex.org/license",
  "mach:licenseVerified": true,
