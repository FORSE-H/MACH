  "identifier": "openaps",
  "name": "OpenAPS",
  "alternateName": [
    "oref0",
    "Open Artificial Pancreas System"
  ],
  "description": "Community-built open-source reference implementation of an automated insulin delivery (AID) algorithm for Type 1 diabetes — the original DIY artificial pancreas system. The oref0 component implements glucose monitoring, insulin-on-board calculations, profile management, and Nightscout integration across three layers: monitor (data collection), predict (glucose forecasting), and control (basal rate adjustment). Designed for patient-led self-implementation with a Raspberry Pi or Edison and a compatible insulin pump. The OpenAPS algorithm directly influenced FDA-cleared commercial APS systems. MIT licensed, 475 stars, 404 forks, community-governed.",
  "url": "https://openaps.org/",
  "codeRepository": "https://github.com/openaps/oref0",
  "license": "MIT",
  "version": "0.7.1",
  "dateModified": "2022-06-19",
