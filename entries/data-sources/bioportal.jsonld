  "identifier": "bioportal",
  "name": "NCBO BioPortal",
  "alternateName": [
    "BioPortal",
    "National Center for Biomedical Ontology BioPortal"
  ],
  "description": "The world's largest repository of biomedical ontologies and terminologies, maintained by the National Center for Biomedical Ontology (NCBO) at Stanford University. Hosts 1,000+ ontologies including OBO Foundry standards (GO, CHEBI, HP, MONDO, UBERON, OBI), clinical terminologies (SNOMED CT, LOINC, RxNorm, ICD), and disease ontologies. Free REST API (data.bioontology.org) provides ontology search, concept lookup, semantic annotation of text, cross-ontology mapping, and ontology recommender. API key required (free registration). Widely used in biomedical NLP, clinical terminology lookup, and knowledge graph construction. NIH-funded (NCBO is an NIH National Center). Used by Elicit, Climb, and major clinical AI platforms as the ontology resolution layer.",
  "url": "https://bioportal.bioontology.org/",
  "relatedLink": [
    "https://data.bioontology.org/",
    "https://github.com/ncbo",
    "https://www.bioontology.org/"
  ],
