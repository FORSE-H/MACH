  "identifier": "eicu",
  "name": "eICU Collaborative Research Database",
  "alternateName": [
    "eICU-CRD"
  ],
  "description": "Multi-center ICU database containing data from 200,000+ admissions of 139,000+ patients across 335 ICU units at 208 hospitals across the continental United States, collected in 2014–2015 via Philips Healthcare's eCareManager telehealth system. Covers charted vital signs, nursing assessments, care plans, diagnosis codes, lab results, medication orders, and respiratory charting. Key differentiator from MIMIC-IV: multi-center design enables generalisability studies and hospital-level variation analysis. PhysioNet Credentialed Health Data License 1.5.0 — requires free PhysioNet credentialing, CITI training, and DUA signature. v2.0 (April 2019). Published in Scientific Data 2018 (Pollard et al.). Developed by MIT Laboratory for Computational Physiology and Philips Healthcare.",
  "url": "https://physionet.org/content/eicu-crd/",
  "license": "PhysioNet-CHDL-1.5",
  "version": "2.0",
  "dateModified": "2019-04-15",
