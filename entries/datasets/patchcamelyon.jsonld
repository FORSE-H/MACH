  "identifier": "patchcamelyon",
  "name": "PatchCamelyon",
  "alternateName": [
    "PCam"
  ],
  "description": "Binary image classification benchmark derived from CAMELYON16, consisting of 327,680 colour patches (96×96 px) extracted from H&E-stained lymph node WSIs, labelled for presence or absence of metastatic breast cancer tissue. Split into 262,144 training, 32,768 validation, and 32,768 test examples (~7.7 GB compressed HDF5). Widely used as a computationally accessible entry point to computational pathology — models can be trained on a single GPU in hours while remaining clinically meaningful. Available via Zenodo and Google Drive. CC0, MIT code licence. 521 stars.",
  "url": "https://github.com/basveeling/pcam",
  "codeRepository": "https://github.com/basveeling/pcam",
  "license": "CC0-1.0",
  "keywords": [
    "digital-pathology",
    "breast-cancer",
    "metastasis-detection",
    "patch-classification",
    "benchmark",
    "h-and-e",
    "lymph-node",
    "binary-classification",
    "camelyon"
  ],
