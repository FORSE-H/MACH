  "programmingLanguage": ["Python"],
  "applicationCategory": "Healthcare",
  "keywords": ["clinical-nlp", "bert", "ehr", "named-entity-recognition", "mimic"],

  "mach:weightsLicense": "MIT",
  "mach:trainingDataSummary": "Pre-trained on approximately 2 million clinical notes from MIMIC-III (PhysioNet). Requires MIMIC data use agreement. Fine-tuned on discharge summaries for readmission prediction.",
  "mach:intendedUse": "Clinical text analysis tasks: named entity recognition, text classification, information extraction from EHR free-text. Research use. Not validated for direct clinical decision support.",
  "mach:aiActRiskClass": "high-risk-candidate",
