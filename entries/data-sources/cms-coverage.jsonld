  "identifier": "cms-coverage",
  "name": "CMS Medicare Coverage Database",
  "alternateName": [
    "CMS MCD",
    "Medicare Coverage Database",
    "LCD",
    "NCD"
  ],
  "description": "The authoritative US federal database of Medicare coverage determinations — National Coverage Determinations (NCDs) and Local Coverage Determinations (LCDs) — maintained by the Centers for Medicare and Medicaid Services (CMS). NCDs are nationwide policies determining whether Medicare covers a specific item or service; LCDs are regional contractor-level decisions. Covers 100+ active NCDs and 1,000+ LCDs across medical procedures, diagnostic tests, durable medical equipment, drugs, and devices. Available via the CMS Coverage Database web interface and CMS open data APIs (data.cms.gov). US Government work — public domain. Used in clinical decision support, prior authorisation automation, and AI agent workflows querying Medicare reimbursement policy in plain language.",
  "url": "https://www.cms.gov/medicare-coverage-database/",
