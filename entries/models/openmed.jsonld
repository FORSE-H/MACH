  "identifier": "openmed",
  "name": "OpenMed",
  "description": "Production-ready medical NLP toolkit providing state-of-the-art encoder transformers (BERT, ELECTRA, DeBERTa families) for biomedical named entity recognition (disease, drug, gene, anatomy, oncology) and multilingual clinical de-identification with HIPAA Safe Harbor coverage. All inference runs on-device — no external API calls, no PHI leaving the environment.",
  "url": "https://openmed.life/",
  "codeRepository": "https://github.com/maziyarpanahi/openmed",
  "logo": "../../logos/openmed.svg",
  "license": "Apache-2.0",
  "softwareVersion": "1.4.0",
  "dateModified": "2026-05-11",
  "programmingLanguage": [
    "Python",
    "Swift"
  ],
  "applicationCategory": "Healthcare",
  "keywords": [
    "clinical-nlp",
    "ner",
    "de-identification",
    "phi",
    "hipaa",
    "biomedical",
    "transformers",
    "on-device"
  ],
  "mach:weightsLicense": "Apache-2.0",
  "mach:trainingDataSummary": "Specialised models trained on biomedical NER benchmarks across disease, drug, gene, anatomy, and oncology corpora. De-identification models trained for HIPAA Safe Harbor entity types across 9 languages. Full training data provenance per model listed on Hugging Face model cards.",
  "mach:intendedUse": "Extracting structured clinical entities from unstructured text (EHR notes, discharge summaries, clinical reports). De-identification of clinical documents prior to secondary use or sharing. Research and production use. Not a clinical decision support tool; outputs require human review in regulated settings.",
  "mach:aiActRiskClass": "high-risk-candidate",
  "mach:evaluationReference": [
    {
      "@type": "schema:ScholarlyArticle",
      "url": "https://arxiv.org/abs/2508.01630",
      "name": "OpenMed: State-of-the-art biomedical NER benchmark results"
    }
  ],
  "mach:governance": "individual",
  "mach:category": "ai-ml-models",
  "mach:subcategory": "nlp-ner",
  "mach:maturity": "production",
  "mach:judgement": "Assess",
  "mach:judgementReason": "Strong technical foundation — SOTA on 10 of 12 biomedical NER benchmarks, Apache-2.0 weights, on-device inference, and active development (v1.4.0, 1.1k GitHub stars). Rated Assess rather than Adopt because the peer-reviewed paper is very recent (August 2025) and clinical deployment track record is not yet established. Re-evaluate for Adopt after community adoption evidence accumulates.",
  "mach:editorialReviewedAt": "2026-05-11",
