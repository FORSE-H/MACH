  "identifier": "itk",
  "name": "ITK",
  "alternateName": [
    "Insight Toolkit",
    "Insight Segmentation and Registration Toolkit"
  ],
  "description": "Foundational open-source C++ toolkit for N-dimensional scientific image processing, with primary focus on medical imaging segmentation and registration. Provides algorithms for identifying and classifying structures in 2D/3D/nD medical scans (CT, MRI, ultrasound) and aligning multi-modal images. Available as C++ source and Python packages (pip/conda-forge). Widely used as the underlying library in medical imaging research tools including 3D Slicer, ITK-SNAP, and many imaging AI pipelines. Maintained by the Insight Software Consortium under NumFOCUS fiscal sponsorship. Apache 2.0, 1.6k stars, 728 forks, v5.4.6.",
  "url": "https://itk.org/",
  "codeRepository": "https://github.com/InsightSoftwareConsortium/ITK",
  "license": "Apache-2.0",
  "version": "5.4.6",
  "dateModified": "2026-05-01",
