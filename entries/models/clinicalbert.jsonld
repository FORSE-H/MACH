  "mach:subcategory": "nlp-ner",
  "mach:maturity": "production",
  "mach:judgement": "Adopt",
  "mach:judgementReason": "The most widely adopted clinical BERT variant, with >289k downloads on Hugging Face. Well-documented, peer-reviewed, and broadly used as a baseline. Note: pre-dates EU AI Act; users applying in clinical settings should document compliance separately.",
  "mach:editorialReviewedAt": "2025-10-01",

