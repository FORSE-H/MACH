  "identifier": "echojep",
  "name": "EchoJEPA",
  "alternateName": [
    "Echocardiography Joint-Embedding Predictive Architecture"
  ],
  "description": "Latent predictive foundation model for echocardiography trained on 18 million cardiac ultrasound images using joint-embedding predictive architecture (JEPA). Extracts anatomically meaningful cardiac features while filtering ultrasound speckle noise. Outperforms baselines by ~20% on left ventricular ejection fraction (LVEF) estimation and achieves 79% accuracy with only 1% of labelled training data. Demonstrates strong robustness under acoustic perturbation — degrades only 2% vs 17% for competing approaches. Apache-2.0.",
  "url": "https://github.com/bowang-lab/EchoJEPA",
  "codeRepository": "https://github.com/bowang-lab/EchoJEPA",
  "license": "Apache-2.0",
