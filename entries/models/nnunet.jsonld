  "mach:weightsLicense": "Apache-2.0",
  "mach:trainingDataSummary": "Framework only — no fixed weights. Trains from scratch on any user-provided segmentation dataset using automated self-configuration. Pre-trained models for specific tasks (e.g. TotalSegmentator) built on top of nnU-Net are available separately.",
  "mach:intendedUse": "Medical image segmentation research and clinical decision support development. Supports CT, MRI, and other volumetric modalities. Used in MICCAI challenges, radiology, pathology, and surgical planning workflows. Not a cleared medical device.",
  "mach:aiActRiskClass": "high-risk-candidate",
