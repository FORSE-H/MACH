  "identifier": "monai",
  "name": "MONAI",
  "alternateName": [
    "Medical Open Network for AI"
  ],
  "description": "PyTorch-based open-source framework for deep learning in healthcare imaging, part of the PyTorch Ecosystem. Provides domain-specific transforms for multi-dimensional medical imaging data (CT, MRI, pathology, endoscopy), modular APIs for training workflow composition, specialised network architectures, loss functions, and evaluation metrics. Supports multi-GPU and multi-node distributed training. Underpins the MONAI Model Zoo (pre-trained bundles), MONAI Label (active learning annotation), and MONAI Deploy (clinical deployment). Primary backer is NVIDIA; contributors include King's College London, Vanderbilt University, and the broader medical imaging research community. Apache 2.0, 8.2k stars, 1.5k forks, v1.5.2.",
  "url": "https://monai.io/",
  "codeRepository": "https://github.com/Project-MONAI/MONAI",
