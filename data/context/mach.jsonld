{
  "@context": {
    "@version": 1.1,
    "schema":   "https://schema.org/",
    "codemeta": "https://w3id.org/codemeta/3.0#",
    "dcat":     "http://www.w3.org/ns/dcat#",
    "dcterms":  "http://purl.org/dc/terms/",
    "mldcat":   "https://semiceu.github.io/MLDCAT-AP/releases/3.0.0/#",
    "mach":     "https://github.com/FORSE-H/MACH/blob/main/data/context/mach.jsonld#",
    "spdx":     "https://spdx.org/rdf/terms/#",

    "name":               "schema:name",
    "alternateName":      "schema:alternateName",
    "description":        "schema:description",
    "url":                "schema:url",
    "identifier":         "schema:identifier",
    "logo":               "schema:logo",
    "license":            "schema:license",
    "softwareVersion":    "schema:softwareVersion",
    "dateModified":       "schema:dateModified",
    "dateCreated":        "schema:dateCreated",
    "programmingLanguage":"schema:programmingLanguage",
    "operatingSystem":    "schema:operatingSystem",
    "applicationCategory":"schema:applicationCategory",
    "keywords":           "schema:keywords",
    "author":             "schema:author",
    "maintainer":         "schema:maintainer",
    "copyrightHolder":    "schema:copyrightHolder",
    "funding":            "schema:funding",
    "isPartOf":           "schema:isPartOf",
    "hasPart":            "schema:hasPart",
    "codeRepository":     "codemeta:codeRepository",
    "contIntegration":    "codemeta:contIntegration",
    "issueTracker":       "codemeta:issueTracker",
    "relatedLink":        "codemeta:relatedLink",

    "mach:category":            { "@id": "mach:category" },
    "mach:subcategory":         { "@id": "mach:subcategory" },
    "mach:judgement":           { "@id": "mach:judgement" },
    "mach:judgementReason":     { "@id": "mach:judgementReason" },
    "mach:maturity":            { "@id": "mach:maturity" },
    "mach:governance":          { "@id": "mach:governance" },
    "mach:foundation":          { "@id": "mach:foundation" },
    "mach:clinicalDomain":      { "@id": "mach:clinicalDomain", "@container": "@set" },
    "mach:deploymentContext":   { "@id": "mach:deploymentContext", "@container": "@set" },
    "mach:supportsStandard":    { "@id": "mach:supportsStandard", "@container": "@set" },
    "mach:evidence":            { "@id": "mach:evidence", "@container": "@set" },
    "mach:evidenceType":        { "@id": "mach:evidenceType" },
    "mach:alternativeTo":       { "@id": "mach:alternativeTo", "@container": "@set" },
    "mach:editorialReviewedAt": { "@id": "mach:editorialReviewedAt" },

    "mach:weightsLicense":      { "@id": "mldcat:weightsLicense" },
    "mach:trainingDataSummary": { "@id": "mldcat:trainingDataSummary" },
    "mach:intendedUse":         { "@id": "mldcat:intendedUse" },
    "mach:evaluationReference": { "@id": "mldcat:evaluationReference", "@container": "@set" },
    "mach:aiActRiskClass":      { "@id": "mldcat:aiActRiskClass" },

    "mach:transport":           { "@id": "mach:transport" },
    "mach:authMethod":          { "@id": "mach:authMethod" },
    "mach:fhirVersion":         { "@id": "mach:fhirVersion" },
    "mach:mcpSpecVersion":      { "@id": "mach:mcpSpecVersion" },

    "mach:huggingFaceUrl":      { "@id": "mach:huggingFaceUrl" },
    "mach:swhid":               { "@id": "mach:swhid" }
  }
}
