  "identifier": "txagent",
  "name": "TxAgent",
  "description": "AI agent for therapeutic reasoning that chains 211 expert-curated biomedical tools (ToolUniverse) to analyse drug interactions, contraindications, and patient-specific treatment strategies. Uses multi-step reasoning over sources including openFDA, Open Targets, and the Human Phenotype Ontology. Achieves 92.1% accuracy on open-ended drug reasoning tasks, surpassing GPT-4o by up to 25.8%. Developed by the Zitnik Lab at Harvard Medical School as part of precision medicine and clinical AI research.",
  "url": "https://zitniklab.hms.harvard.edu/TxAgent/",
  "codeRepository": "https://github.com/mims-harvard/TxAgent",
  "license": "MIT",
  "dateModified": "2025-03-01",
