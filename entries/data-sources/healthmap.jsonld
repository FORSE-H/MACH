  "identifier": "healthmap",
  "name": "HealthMap",
  "alternateName": [
    "Outbreaks Near Me"
  ],
  "description": "Automated global disease surveillance system developed at Boston Children's Hospital in 2006 by Clark Freifeld and John Brownstein. Aggregates and classifies outbreak signals 24/7 from online news aggregators, eyewitness reports, expert-curated discussions (including ProMED), and validated official reports to produce a unified real-time map of infectious disease activity worldwide. Covers human and animal health events across all disease types. Funded by Google.org, the Life Buoy Fund, NLM, CDC, and Canadian Institutes of Health Research. Also available as the mobile app 'Outbreaks Near Me'. No public API is available; data access is governed by a binding user agreement with Children's Hospital Boston rather than an open license, limiting programmatic reuse.",
  "url": "https://healthmap.org/",
  "relatedLink": [
    "https://healthmap.org/about/",
    "https://www.healthmap.org/about/termsofuse/"
  ],
  "license": "LicenseRef-proprietary",
