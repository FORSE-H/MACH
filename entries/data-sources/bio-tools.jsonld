  "name": "bio.tools",
  "alternateName": [
    "ELIXIR Tools Registry"
  ],
  "description": "ELIXIR's registry of bioinformatics and life science software, hosting over 33,000 tools. Each entry is structured using biotoolsSchema and classified with the EDAM ontology (operations, data types, formats, topics). Covers tools relevant to medical informatics, genomics, proteomics, imaging, and computational biology. Fully public REST API with no authentication required for reads — supports filtering by topic, operation, license, programming language, and 40+ other fields. Data released under CC-BY-SA-4.0. Governed by the Danish ELIXIR Node and ELIXIR Tools Platform.",
  "url": "https://bio.tools/",
