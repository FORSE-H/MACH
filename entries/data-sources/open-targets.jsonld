  "identifier": "open-targets",
  "name": "Open Targets Platform",
  "alternateName": [
    "Open Targets"
  ],
  "description": "Open science platform for systematic identification and prioritisation of drug targets using human genetic, genomic, and disease evidence. Integrates data from GWAS, gene expression, somatic mutations, animal models, known drugs, and literature to generate target-disease association scores across 60,000+ targets and 23,000+ diseases/phenotypes. Provides a REST API, GraphQL API, and bulk data downloads (Parquet/JSON). Maintained by a public-private partnership: EMBL-EBI, Wellcome Sanger Institute, GSK, AstraZeneca, Bristol Myers Squibb, and Pfizer. Data releases every two months. Code Apache-2.0; data CC BY 4.0.",
  "url": "https://platform.opentargets.org",
  "relatedLink": [
    "https://github.com/opentargets",
    "https://platform.opentargets.org/api"
  ],
  "license": "Apache-2.0",
  "keywords": [
    "drug-targets",
    "genomics",
    "gwas",
    "disease-association",
    "target-prioritisation",
    "open-data",
    "graphql",
    "rest-api",
    "pharma",
    "precision-medicine"
  ],
