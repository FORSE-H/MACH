    "nndetection"
  ],
  "description": "Self-configuring framework for 3D volumetric medical object detection, applying the same automated configuration philosophy as nnU-Net to detection tasks. Handles dataset fingerprinting, architecture selection, and training without manual tuning. Includes guides for 12 benchmark datasets.",
  "url": "https://github.com/MIC-DKFZ/nnDetection",
