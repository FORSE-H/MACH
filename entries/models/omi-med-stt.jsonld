  "mach:weightsLicense": "CC-BY-4.0",
  "mach:trainingDataSummary": "Built on NVIDIA Parakeet TDT 0.6B v2. Full training-data composition is not specified in the model card; the published evaluation uses 7.18 hours of real and synthetic clinical speech spanning dialogue, dictation, medication review, procedures/devices/tests, and general speech. Specialised vocabulary covers GP consultations, medication, and procedure/device/test terminology.",
  "mach:intendedUse": "Local transcription of clinical conversations and medical dictation (ambient-scribe and documentation workflows). Not a diagnostic, triage, prescribing, or clinical-decision model; the authors require human review of transcripts before any clinical use. Not a cleared medical device.",
  "mach:aiActRiskClass": "high-risk-candidate",
  "mach:governance": "vendor-led",
  "mach:foundation": "Omi Health",
