  "identifier": "geneagent",
  "name": "GeneAgent",
  "description": "Self-verifying LLM agent for gene-set analysis that autonomously queries domain databases (Gene Ontology, KEGG, NCBI Gene, PubMed) to annotate biological functions for user-provided gene sets. Employs a generate-verify-revise loop to cross-check outputs against authoritative databases, reporting a 40% reduction in hallucinations versus baseline LLMs. Published in Nature Methods 2025. Developed at NCBI/NLM, NIH.",
  "url": "https://www.ncbi.nlm.nih.gov/CBBresearch/Lu/Demo/GeneAgent/",
  "codeRepository": "https://github.com/ncbi-nlp/GeneAgent",
