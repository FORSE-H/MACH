  "identifier": "pro-act",
  "name": "PRO-ACT",
  "alternateName": [
    "Pooled Resource Open-Access ALS Clinical Trials Database"
  ],
  "description": "The largest publicly accessible database of amyotrophic lateral sclerosis (ALS) clinical-trial data: 13,717 fully de-identified subject records pooled from 44 Phase II/III trials (placebo and active arms), with 18+ million longitudinal data points — ALSFRS(-R), FVC/SVC, vital signs, labs, medications, adverse events, survival, strength, and neurofilament. Widely used for ALS prognostic modelling and trial design. Run by the Neurological Clinical Research Institute at Massachusetts General Hospital with Prize4Life, the ALS Association, and consortium partners. Access is free but registration-gated with a click-through data-use agreement (no re-identification, citation and manuscript-review obligations, and country-of-concern restrictions) — 'open-access' here means open to registered users, not open bulk download.",
  "url": "https://ncri1.partners.org/ProACT",
  "relatedLink": [
    "https://ncri1.partners.org/ProACT/Document/DisplayLatest/6",
    "https://www.alsdata.org/"
  ],
  "license": "LicenseRef-PRO-ACT-terms",
  "mach:licenseNote": "Custom click-through Data Use Agreement (NCRI / Mass General) — free registration required; no re-identification, no resale, citation + manuscript-review obligations; access restricted for certain countries under US DOJ 28 CFR Part 202. Not a standard open-data licence.",
  "mach:licenseVerified": true,
