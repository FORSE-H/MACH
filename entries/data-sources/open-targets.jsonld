    {
      "@type": "Organization",
      "name": "Open Targets (EMBL-EBI / Wellcome Sanger / GSK / AstraZeneca / BMS / Pfizer)",
      "url": "https://www.opentargets.org"
    }
  ],
  "mach:governance": "foundation",
  "mach:foundation": "Open Targets partnership (EMBL-EBI led)",
  "mach:category": "data-sources",
  "mach:maturity": "production",
  "mach:deploymentContext": [
    "cloud"
  ],
  "mach:clinicalDomain": [
    "oncology",
    "rare-disease",
    "research",
    "pharmacology"
  ],
  "mach:judgement": "Adopt",
  "mach:judgementReason": "The de-facto open platform for evidence-based drug target identification — integrates genetics, genomics, and disease data across 60k+ targets with a REST/GraphQL API and CC BY 4.0 bulk downloads. Public-private partnership (EMBL-EBI + GSK + AstraZeneca + BMS + Pfizer) ensures long-term sustainability. Adopt for any team building target discovery pipelines, drug repurposing models, or grounding clinical AI with gene-disease associations.",
  "mach:editorialReviewedAt": "2026-05-18",
