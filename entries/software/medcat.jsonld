  "identifier": "medcat",
  "name": "MedCAT",
  "alternateName": [
    "Medical Concept Annotation Tool"
  ],
  "description": "Clinical NLP toolkit for named entity recognition and linking in free-text clinical notes. Performs concept extraction and normalisation against SNOMED CT, UMLS, and custom ontologies, with built-in active learning and meta-annotation (negation, temporality, experiencer). Used in NHS trusts, CogStack deployments, and clinical NLP research pipelines.",
  "url": "https://medcat.readthedocs.io/",
