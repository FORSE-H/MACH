  "identifier": "clinicalbert",
  "name": "ClinicalBERT",
  "description": "BERT model pre-trained on clinical notes from MIMIC-III, fine-tuned for clinical NLP tasks including named entity recognition and clinical text classification.",
  "url": "https://huggingface.co/medicalai/ClinicalBERT",
  "codeRepository": "https://github.com/kexinhuang12345/clinicalBERT",
  "logo": "../../logos/clinicalbert.svg",

  "license": "MIT",
  "softwareVersion": "1.0",
