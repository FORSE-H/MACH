  "mach:weightsLicense": "MIT",
  "mach:trainingDataSummary": "250 million protein sequences from UniRef50 (UR50D split); self-supervised masked language modelling",
  "mach:intendedUse": "Protein structure prediction, function annotation, variant effect estimation, fine-tuning for downstream drug discovery and genomics tasks",
