  "identifier": "vista",
  "name": "VistA",
  "alternateName": [
    "WorldVistA",
    "Veterans Health Information Systems and Technology Architecture"
  ],
  "description": "The Veterans Health Information Systems and Technology Architecture — the comprehensive EHR and HIS that has run the US Department of Veterans Affairs healthcare system for decades, serving millions of veterans across 170+ VA medical centres. One of the largest integrated healthcare IT deployments in the world. Built on MUMPS/GT.M, with the open-source community version maintained by OSEHRA (Open Source Electronic Health Record Alliance) and WorldVistA. Also deployed by the Indian Health Service (RPMS). The VA is currently migrating to Oracle Cerner, signalling the end of VistA's primary deployment era. Apache 2.0, 140 stars, last open-source release 2020.",
  "url": "https://worldvista.org/",
  "codeRepository": "https://github.com/WorldVistA/VistA",
  "license": "Apache-2.0",
  "dateModified": "2020-07-20",
